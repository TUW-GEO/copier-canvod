cff-version: 1.2.0
message: "If you use this software, please cite it as below, and cite canVODpy."
type: software
title: "[[ dist_name ]]: [[ description ]]"
abstract: >
  [[ description ]] [[ dist_name ]] is a package for canVODpy, an open
  Python ecosystem for GNSS-Transmissometry canopy VOD retrievals.
authors:
  - family-names: "[[ author_family_name ]]"
[% if author_name != author_family_name %]
    given-names: "[[ author_name[:-(author_family_name | length)] | trim ]]"
[% endif %]
    email: [[ author_email ]]
[% if affiliation %]
    affiliation: "[[ affiliation ]]"
[% endif %]
[% if author_orcid %]
    orcid: "https://orcid.org/[[ author_orcid ]]"
[% endif %]
repository-code: "[[ repo_url ]]"
license: Apache-2.0
references:
  - type: software
    title: "canVODpy: An Open Python Ecosystem for GNSS-Transmissometry Canopy VOD Retrievals"
    authors:
      - family-names: Bader
        given-names: Nicolas François
        orcid: "https://orcid.org/0000-0002-9932-1925"
    repository-code: "https://github.com/TUW-GEO/canvodpy"
    url: "https://github.com/TUW-GEO/canvodpy"
    doi: "10.5281/zenodo.18496233"
    license: Apache-2.0
