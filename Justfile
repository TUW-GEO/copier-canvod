# copier-canvod: checks of the template itself

_default:
    @just --list --unsorted

# generate a package with CI off and on, then check, test and build the docs of each
test:
    #!/usr/bin/env bash
    set -euo pipefail
    out=$(mktemp -d)
    trap 'rm -rf "$out"' EXIT
    # in a git checkout: HEAD plus uncommitted changes, not the latest tag
    ref=()
    if git rev-parse --git-dir >/dev/null 2>&1; then ref=(--vcs-ref HEAD); fi
    for ci in false true; do
        dest="$out/ci-$ci"
        echo "== ci_enabled=$ci: $dest"
        uvx copier copy --trust --defaults --quiet ${ref[@]+"${ref[@]}"} \
            -d dist_name=canvod-fangorn-test \
            -d 'description=A package generated by the template test.' \
            -d github_owner=example -d author_name='J. R. R. Tolkien' \
            -d author_email=jrrt@example.org -d copyright_year=2026 \
            -d 'canvodpy_deps=["canvod-utils"]' -d ci_enabled=$ci \
            . "$dest"
        if grep -rnE '\[\[ |\[% ' --exclude-dir=.git --exclude-dir=.venv "$dest"; then
            echo "unrendered template tags" >&2; exit 1
        fi
        (cd "$dest" && uv sync --quiet && just check && just test && just check-release-notes && uv run zensical build --clean)
    done
