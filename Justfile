# copier-canvod: checks of the template itself

_default:
    @just --list --unsorted

# generate packages (CI off and on, awkward answers), check that their files
# parse, then check, test and build the docs of each; answers that must be
# refused are refused
test:
    #!/usr/bin/env bash
    set -euo pipefail
    out=$(mktemp -d)
    trap 'rm -rf "$out"' EXIT
    # in a git checkout: HEAD plus uncommitted changes, not the latest tag
    ref=()
    if git rev-parse --git-dir >/dev/null 2>&1; then ref=(--vcs-ref HEAD); fi
    dests=()
    generate() {
        uvx copier copy --trust --defaults --quiet ${ref[@]+"${ref[@]}"} "$@"
    }
    parse() {
        uv run --no-project --quiet --python 3.14 --with pyyaml --with cffconvert \
            python tests/check_generated.py "$1"
    }
    # the defaults most packages take: CI off and on
    for ci in false true; do
        dest="$out/ci-$ci"
        echo "== ci_enabled=$ci: $dest"
        generate \
            -d dist_name=canvod-fangorn-test \
            -d 'description=A package generated by the template test.' \
            -d github_owner=example -d github_handle=jrrt \
            -d author_name='J. R. R. Tolkien' \
            -d author_email=jrrt@example.org -d copyright_year=2026 \
            -d 'canvodpy_deps=["canvod-utils"]' -d ci_enabled=$ci \
            . "$dest"
        dests+=("$dest")
    done
    # awkward answers: a long name, a family name with particles, every
    # optional answer set, several dependencies, canvodpy itself
    dest="$out/awkward"
    echo "== awkward answers: $dest"
    generate \
        -d dist_name=canvod-sky-cell-stats2 \
        -d "description=Per-cell sky statistics: Fangorn's canopy, 50 % gaps & <tags>." \
        -d github_owner=Example-Org -d github_handle=fimbrethil-2 \
        -d author_name='Fimbrethil Ent-wife van der Fangorn' \
        -d author_family_name='van der Fangorn' \
        -d author_email=fimbrethil@example.org -d author_orcid=0000-0002-1825-0097 \
        -d 'affiliation=Forest Research Unit, University of Bloemfontein' \
        -d copyright_year=2026 -d docs_domain=docs.example.org \
        -d impressum_url=https://example.org/impressum \
        -d 'canvodpy_deps=["canvodpy", "canvod-grids", "canvod-viz"]' \
        -d target=canvodpy -d ci_enabled=true \
        . "$dest"
    dests+=("$dest")
    # a one-word name: CITATION.cff without given-names
    dest="$out/one-word"
    echo "== one-word author name: $dest"
    generate \
        -d dist_name=canvod-onodrim -d 'description=One name only.' \
        -d github_owner=example -d github_handle=treebeard \
        -d author_name=Treebeard -d author_email=treebeard@example.org \
        -d copyright_year=2026 -d 'canvodpy_deps=["canvod-utils"]' \
        . "$dest"
    if grep -A1 'family-names: "Treebeard"' "$dest/CITATION.cff" | grep -q 'given-names'; then
        echo "one-word name: CITATION.cff has given-names" >&2; exit 1
    fi
    parse "$dest"
    for dest in "${dests[@]}"; do
        echo "== checks: $dest"
        if grep -rnE '\[\[ |\[% ' --exclude-dir=.git --exclude-dir=.venv "$dest"; then
            echo "unrendered template tags" >&2; exit 1
        fi
        if grep -n 'Nicolas François Bader' "$dest/SECURITY.md"; then
            echo "SECURITY.md names the template's author" >&2; exit 1
        fi
        parse "$dest"
        (cd "$dest" && uv sync --quiet && just check && just test \
            && just check-release-notes && just check-reuse && uv run zensical build --clean)
    done
    # answers that must be refused
    # refused: copier must stop with the validation message of that question
    refused() {
        local label=$1 question=$2; shift 2
        local log
        if log=$(generate -d dist_name=canvod-refused-test -d 'description=Refused.' \
            -d github_owner=example -d github_handle=jrrt -d author_name='J. R. R. Tolkien' \
            -d author_email=jrrt@example.org -d copyright_year=2026 \
            -d 'canvodpy_deps=["canvod-utils"]' "$@" . "$out/refused" 2>&1); then
            echo "not refused: $label" >&2; exit 1
        fi
        rm -rf "$out/refused"
        if ! grep -qF "Validation error for question '$question'" <<<"$log"; then
            echo "failed, but not on the validator of $question: $label" >&2
            echo "$log" | tail -5 >&2; exit 1
        fi
        echo "refused as it should be: $label"
    }
    refused 'a canvodpy package name' dist_name -d dist_name=canvod-grids
    refused 'an extensions package name' dist_name -d dist_name=canvod-filemap
    refused 'a Python keyword as module' module_name -d module_name=class
    refused 'a taken canvod module' module_name -d module_name=readers
    refused 'a double quote in description' description -d 'description=Reads "SBF" files.'
    refused 'a backslash in author_name' author_name -d 'author_name=J. R. R. Tolk\ien'
    refused 'a double quote in affiliation' affiliation -d 'affiliation=The "Shire" College'
    refused 'a family name not ending the name' author_family_name -d author_family_name=Baggins
    refused 'an @ in github_handle' github_handle -d github_handle=@jrrt

# ============================================================================
# Release Management
# ============================================================================

# The template is released as git tags v<version> with a GitHub release;
# `copier copy` and `copier update` in a package take the newest tag.
# Which increment (canvodpy's rules, applied to the template):
#   patch  a fix: a wrong file, hook or text in generated packages
#   minor  a new question, file or recipe; a question marked as going away
#   major  a question renamed or removed, or a change that breaks
#          `copier update` of existing packages
# If it is unclear which, ask the maintainers instead of guessing.

# show the changes since the last release
changelog:
    uvx git-cliff --unreleased

# release commit, e.g. `just release minor` or `just release 0.1.0`: changelog section for the new version
release VERSION: test
    #!/usr/bin/env bash
    set -euo pipefail
    test -z "$(git status --porcelain)" || { echo "Commit or discard your changes first" >&2; exit 1; }
    last=$(git tag -l 'v[0-9]*' --sort=-v:refname | head -n 1)
    case "{{VERSION}}" in
        major|minor|patch)
            test -n "${last}" || { echo "No release yet: give the first version, e.g. just release 0.1.0" >&2; exit 1; }
            IFS=. read -r ma mi pa <<< "${last#v}"
            pa="${pa%%[!0-9]*}"
            case "{{VERSION}}" in
                major) version="$((ma + 1)).0.0" ;;
                minor) version="${ma}.$((mi + 1)).0" ;;
                patch) version="${ma}.${mi}.$((pa + 1))" ;;
            esac ;;
        *) version="{{VERSION}}" ;;
    esac
    tag="v${version}"
    if git rev-parse -q --verify "refs/tags/${tag}" >/dev/null; then
        echo "Tag ${tag} exists already" >&2; exit 1
    fi
    # add only the new section, so edits to earlier sections stay
    if test -f CHANGELOG.md; then
        uvx git-cliff --unreleased --tag "${tag}" --prepend CHANGELOG.md
    else
        uvx git-cliff --tag "${tag}" --output CHANGELOG.md
    fi
    perl -0pi -e 's/\n+\z/\n/' CHANGELOG.md
    git add CHANGELOG.md
    git commit -m "chore(release): ${version}"
    echo ""
    echo "Release commit for ${tag} created. Next steps (main requires a PR):"
    echo "  1. Push this branch (git push --no-follow-tags), open a PR and merge it"
    echo "  2. git checkout main && git pull, then: just tag"
    echo "  3. Publish the draft GitHub release that the tag creates"

# tag the newest version in CHANGELOG.md on an up-to-date main and push the tag
tag:
    #!/usr/bin/env bash
    set -euo pipefail
    git fetch --quiet origin main --tags
    test "$(git branch --show-current)" = main || { echo "Check out main first" >&2; exit 1; }
    test "$(git rev-parse HEAD)" = "$(git rev-parse origin/main)" || { echo "main differs from origin/main: git pull first" >&2; exit 1; }
    tag=$(grep -m 1 -oE '^## \[v[^]]+\]' CHANGELOG.md | sed -E 's/^## \[(.*)\]$/\1/')
    test -n "${tag}" || { echo "No release in CHANGELOG.md: run just release first" >&2; exit 1; }
    if git rev-parse -q --verify "refs/tags/${tag}" >/dev/null; then
        echo "Tag ${tag} exists already: run just release first" >&2; exit 1
    fi
    git tag -a "${tag}" -m "copier-canvod ${tag#v}"
    # only this tag: with push.followTags set, git would also send every
    # annotated tag on main that origin lacks
    git push --no-follow-tags origin "${tag}"
